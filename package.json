{
  "name": "liyuan",
  "version": "1.8.16",
  "description": "梨园（Liyuan）— 以 AI 为主演的角色扮演剧院",
  "scripts": {
    "git:public": "node scripts/prepare-public-git.mjs",
    "test:public-git": "node --test test/public-git.test.ts",
    "privacy:check": "node scripts/check-repository-privacy.mjs",
    "privacy:staged": "node scripts/check-repository-privacy.mjs --staged",
    "privacy:commit": "node scripts/check-repository-privacy.mjs --commit",
    "test:privacy": "node --test test/repository-privacy.test.ts test/publication-range.test.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "test:frontend-version": "node web/test/build-version.test.ts",
    "test:connect-config": "node web/src/model-tool-support.test.mjs",
    "test:connect-browser": "node web/test/connect-panel.test.mjs",
    "test:record-reader": "node web/test/real-test-reader.test.mjs",
    "test:lorebook-panel": "node test/lorebook-panel-rest.test.ts && node test/lorebook-cache.test.ts",
    "test:lorebook-browser": "node web/test/lorebook-panel.test.mjs",
    "test:novel-play": "node --test --test-concurrency=1 \"test/novel-play*.test.ts\"",
    "test:release": "node test/release-data-policy.test.ts",
    "test:rest-lifecycle": "node test/rest-lifecycle.test.ts",
    "verify": "npm run typecheck && npm test && npm run test:frontend-version && npm run test:connect-config && npm --prefix web run typecheck",
    "web": "node server/main.ts",
    "web:new": "node server/main.ts --new",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "pack:release": "powershell -NoProfile -File scripts/pack-release.ps1 -Target all",
    "pack:release:windows": "powershell -NoProfile -File scripts/pack-release.ps1 -Target windows",
    "pack:release:linux": "powershell -NoProfile -File scripts/pack-release.ps1 -Target linux",
    "pack:release:macos": "powershell -NoProfile -File scripts/pack-release.ps1 -Target macos",
    "test:database-plugin": "node --test test/database-plugin*.test.ts",
    "test:database-plugin-browser": "node web/test/database-plugin-runtime.test.mjs",
    "test:database-plugin-manager": "node web/test/database-plugin-manager.test.mjs",
    "database-plugin:install": "node scripts/install-database-plugin.mjs",
    "test:tavern-plugins": "node --test test/tavern-plugin*.test.ts",
    "test:tavern-plugins-browser": "node --test --test-concurrency=1 web/test/tavern-plugin*.test.mjs",
    "test:tavern-plugins-native": "node scripts/test-tavern-native.mjs",
    "tavern-plugins:install": "node scripts/install-tavern-plugins.mjs",
    "test:tavern-plugins-lifecycle": "node --experimental-test-module-mocks --test test/tavern-plugin-lifecycle.test.ts",
    "test:npc-parallel": "node --test test/npc-parallel*.test.ts",
    "test:npc-parallel-browser": "node --test --test-concurrency=1 web/test/npc-parallel*.test.mjs",
    "test:veridis-rewrite": "node --test test/veridis-rewrite*.test.ts",
    "test:veridis-rewrite-browser": "node --test web/test/veridis-rewrite-workbench.test.mjs",
    "test:global-options": "node --test test/regex-options.test.ts && node --test web/test/global-options-messages.test.mjs",
    "npc-parallel:install": "node scripts/install-npc-parallel.mjs",
    "veridis-rewrite:install": "node scripts/install-veridis-rewrite.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@liyuan/agent-runtime": "file:./packages/coding-agent",
    "@liyuan/ai": "file:./packages/ai",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "playwright": "^1.49.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ws": "^8.18.2"
  }
}
