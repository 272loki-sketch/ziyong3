# Upstream binary with uncleared redistribution; retain the local source object.
/packages/coding-agent/examples/extensions/doom-overlay/doom/build/doom.wasm

# Exact reviewed license texts and component notices only.
/licenses/*
!/licenses/Luker-AGPL-3.0.txt
!/licenses/README.md

