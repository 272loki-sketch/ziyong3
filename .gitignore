# 根级排查脚手架（下划线约定）+ 旧实验目录 + 调试截图
# 与 pack-release.ps1 的 $dropGlobs 同口径（那里已有 "_*"，注释写着 root-level
# dev scratch）——两处用同一套约定，别再各自点名。锚定根级 `/_*` 而非 `_*`，
# 否则会波及已入库的 scripts/_privacy_scan.py。
/_*
/scratch/
/summaries/
/output/
/persist/
/liyuan-*.png
# 同 $dropGlobs：内部调试脚本不随包、也不入库（已入库的同名前缀文件不受影响）
scripts/build-fanren-*.mjs
scripts/check-*.mjs
scripts/debug-*.mjs
scripts/find-*.mjs
scripts/live-*.mjs
scripts/probe-*.mjs
!scripts/probe-backstage.mjs
scripts/verify-*.mjs
scripts/write-*.mjs

# optional: keep web/dist for easier clone-and-run; uncomment to force rebuild
# web/dist/

# 预设→skill 装载期生成物（用户数据，不入库）
skills/预设-*/
/.backup/
/.tmp-liyuan-e2e-test.mjs

# Protected local pre-deploy static bundles, never source/release artifacts
web/.dist-*/

# 原子卡保存的未提交临时字节可能含私人内嵌书；即使异常中断也不得入库
**/.liyuan-card-*.tmp

# External database plugin private state, vectors, settings and upstream cache
.liyuan-database-plugin/

# Atomic config staging may contain private data if interrupted; never commit
**/.liyuan-json-*.tmp

# Original Tavern plugins, derived private state and pinned browser dependency cache
.liyuan-tavern-plugins/

web/.liyuan-tavern-*/

# Public synthetic main/card/plugin canary
!scripts/check-tavern-canary.mjs
# Public policy tools must remain visible despite diagnostic name conventions.
!scripts/check-public-data.mjs
!scripts/check-repository-privacy.mjs
!scripts/check-publication-range.mjs
!scripts/check-privacy-ci.mjs
!scripts/check-docs.mjs
!scripts/check-director-chat.mjs
!scripts/_privacy_scan.py

# Unmodified NPC upstream cache, credentials/settings and branch-scoped derived state
.liyuan-npc-parallel/

# Locally downloaded original Veridis assets and derived settings/output; never redistributed
.liyuan-veridis-rewrite/

# Host-specific audit/deployment runners: retained locally, not product source.
/scripts/activate-plugin-integration.mjs
/scripts/deploy-npc-settings-ui.mjs
/scripts/deploy-plugin-integration.mjs
/scripts/deploy-round-plugin-repair.mjs
